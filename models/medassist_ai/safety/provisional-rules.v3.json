  "context": {
    "split": "[.!?;\\n]+|,\\s*|\\b(?:but|however|yet|although|even though)\\b|\\band\\s+(?=(?:now\\s+)?(?:i|he|she|they|her|his|their|my (?:dad|father|mother|mom|mum|child|baby|friend|wife|husband|son|daughter|partner|brother|sister)|no|not)\\b)",
    "education": "\\b(?:what (?:is|are|does)|define|definition|meaning of|explain|tell me about|learning about|studying|homework|textbook|medical school|in (?:an? )?(?:article|book|movie|film|novel|script|story)|reading about|read about|article|movie|film|lecture|english class|writing (?:a )?(?:story|script)|training (?:example|exercise)|general question|in general|how would)\\b|\\b(?:can|could|does) .{0,45} cause\\b",
    "hypothetical": "\\b(?:hypothetical|hypothetically|suppose|imagine|imagining|pretend|counterfactual|what would|what should .{0,25} do if|if .{0,45}(?:ever|were to|was to|had|were|became|becomes)|someday|in the future|risk of|worried about getting)\\b",
    "actual_override": "\\b(?:actually|in reality|in real life|right now|at this moment|happening now)\\b",
    "remote": "\\b(?:years? ago|decades? ago|months? ago|last year|last month|as a (?:child|toddler)|in childhood|in the past|history of|old (?:event|history)|back in (?:19|20)\\d{2}|in (?:19|20)\\d{2})\\b",
    "recent": "\\b(?:just|now|currently|today|tonight|yesterday|earlier|this (?:morning|afternoon|evening)|last night|a moment ago|moments? ago|minutes? ago|hours? ago|still|happening|at present|at the moment|at this moment|all of a sudden|suddenly|sudden|new|newly)\\b",
    "past": "\\b(?:had|was|were|used to|previously|sometime|resolved|stopped|went away|got better|faded|returned to normal)\\b",
    "current": "\\b(?:am|is|are|have|has|having|feel|feels|experiencing|suffering|cannot|can barely|need|needs|think|believe|reckon|suspect|might|may|could)\\b",
    "uncertain": "\\b(?:not sure|unsure|do not know|cannot tell|may|might|maybe|could|possibly|possible|suspect|think|believe|reckon|worried|afraid|cannot rule out)\\b",
    "scope_unknown": "\\b(?:not (?:said|explained)|have not (?:said|explained)|without (?:any )?(?:information|context)|(?:unsure|uncertain).{0,35}context|cannot (?:tell|say).{0,45}(?:when|whose|story|real)|do not know.{0,45}(?:when|whether.{0,25}(?:story|real))|not know.{0,20}when|mentioned|written here|not (?:know|sure).{0,20}(?:who|when))\\b",
    "uncertainty_negation_exceptions": "\\b(?:not sure|do not know|does not know|did not know|cannot tell|cannot rule out|not only)\\b",
    "negation_prefix": "\\b(?:no|not|never|without|deny|denies|denying|do not|does not|did not|is not|are not|was not|have not|has not)\\b(?:\\s+[a-z\\x27]+){0,6}\\s*$",
    "negation_inside": "\\b(?:no|not|never|without|denies|deny)\\b",
    "intrinsic_negative": "\\b(?:not breathing|not responding|not responsive|not conscious|will not (?:wake|respond|stop)|does not (?:wake|respond)|cannot (?:breathe|get|catch|wake|rouse|stop|speak|raise|lift)|unable to|not able to|could not wake)\\b",
    "negation_suffix": "^\\s*(?:(?:is|are|was|were) )?(?:not present|not happening|never happened|ruled out|is false)\\b",
    "other": "\\b(?:(?:my|our|the|a|an) (?:little |young |elderly |older |younger )?(?:dad|father|mother|mom|mum|child|baby|infant|toddler|friend|wife|husband|son|daughter|partner|brother|sister|grandmother|grandfather|aunt|uncle|neighbou?r|man|woman|person|stranger|patient|boy|girl)|he|she|they|his|her|their|him|them|someone|somebody|anyone)\\b",
    "self": "\\b(?:i|me|myself|my (?:(?:left|right|upper|lower) )?(?:chest|face|arm|body|lips|skin|throat|tongue|mouth|blood|hand|leg|words|speech|breathing|smile|heart|neck|jaw|cut))\\b",
    "recent_clause_exclusions": "\\bnot (?:now|currently|today)\\b",
    "idiom": "\\b(?:stroke of luck|brush stroke|paint stroke|golf stroke|swimming stroke|keystroke)\\b",
    "reference": "\\b(?:having|have|had) (?:one|it|this)\\b",
    "inability_fragment": "\\b(?:cannot|unable to|not able to|can barely) (?:breathe|get (?:enough |any )?air)\\b|\\bblood (?:is )?(?:spurting|gushing|pouring)\\b"
