  "rules": [
    {
      "id": "explicit_emergency_request",
      "category": "emergency_request",
      "kind": "request",
      "sources": [
        "india-erss"
      ],
      "patterns": [
        "\\b(?:need|needs|want|requiring|require) (?:urgent |emergency |immediate )?(?:medical |emergency )?(?:help|assistance) (?:right )?(?:now|immediately|urgently)\\b",
        "\\b(?:need|needs) (?:urgent|emergency) (?:help|assistance)\\b",
        "\\b(?:send|get|need|needs|call|request) (?:me |us |for |please |an |the )*ambulance\\b",
        "\\b(?:this is|having) (?:a )?(?:medical )?emergency\\b",
        "\\bcall (?:the )?(?:emergency services|112|911|999)\\b"
      ]
    },
    {
      "id": "reported_cardiac_emergency",
      "category": "cardiac_declaration",
      "kind": "declaration",
      "sources": [
        "nhs-heart"
      ],
      "patterns": [
        "\\b(?:heart attack|cardiac arrest|myocardial infarction)\\b"
      ]
    },
    {
      "id": "cardiac_warning",
      "category": "cardiac_warning",
      "kind": "warning",
      "sources": [
        "nhs-heart"
      ],
      "patterns": [
        "\\b(?:chest|breastbone).{0,40}(?:crush(?:ing|ed)?|squeez(?:ing|ed)?|tight|heavy|heaviness|pressure)\\b",
        "\\b(?:crush(?:ing|ed)?|squeez(?:ing|ed)?|tight|heavy|pressure|weight).{0,45}(?:chest|breastbone)\\b",
        "\\b(?:chest.{0,15}(?:pain|hurts|ache)|pain.{0,20}chest).{0,65}(?:arms?|jaw|neck|back|sweat(?:ing|y)?|breath)\\b",
        "\\b(?:sweating|sweaty|short of breath).{0,40}chest pain\\b"
      ]
    },
    {
      "id": "reported_stroke_emergency",
      "category": "stroke_declaration",
      "kind": "declaration",
      "sources": [
        "nhs-stroke"
      ],
      "patterns": [
        "\\bstroke\\b"
      ]
    },
    {
      "id": "stroke_warning",
      "category": "stroke_warning",
      "kind": "warning",
      "sources": [
        "nhs-stroke"
      ],
      "patterns": [
        "\\b(?:face|mouth|smile).{0,38}(?:droop(?:ing|ed|s)?|uneven|crooked|lopsided|weak)\\b",
        "\\b(?:droop(?:ing|ed|s)?|uneven|crooked|lopsided).{0,30}(?:face|mouth|smile)\\b",
        "\\b(?:one side|left|right).{0,25}(?:face|arm|body).{0,35}(?:weak|numb|gone weak|no strength)\\b",
        "\\b(?:weakness|numbness|weak|numb).{0,28}(?:one side|left|right)\\b",
        "\\b(?:one side of (?:my |his |her |the )?body).{0,30}(?:weak|numb)\\b",
        "\\b(?:cannot|unable to|not able to|will not).{0,15}(?:raise|lift).{0,20}(?:arm|arms)\\b",
        "\\b(?:slurr(?:ing|ed)? (?:my |his |her |their )?(?:speech|words)|(?:speech|words).{0,24}(?:slurred|slurring|garbled|jumbled))\\b",
        "\\b(?:sudden|suddenly|new|newly).{0,45}(?:trouble (?:speaking|getting words out)|cannot speak|unable to speak)\\b"
      ]
    },
    {
      "id": "severe_breathing_warning",
      "category": "severe_breathing",
      "kind": "warning",
      "sources": [
        "nhs-breathing"
      ],
      "patterns": [
        "\\b(?:cannot|unable to|not able to|could not|barely able to|can barely|hardly able to) (?:breathe|get (?:enough |any )?air|catch (?:my|his|her|their) breath)\\b",
        "\\b(?:severe|very|extreme|extremely).{0,25}(?:difficulty|difficult|trouble|struggling).{0,15}breath",
        "\\bbreath(?:ing)?.{0,25}(?:severely|very|extremely) (?:difficult|hard)\\b",
        "\\b(?:struggling|fighting).{0,22}(?:to breathe|for (?:air|breath))\\b",
        "\\b(?:gasping|choking|not breathing(?: normally)?)\\b",
        "\\b(?:lips|skin).{0,25}(?:blue|grey|gray)\\b"
      ]
    },
    {
      "id": "unresponsive_warning",
      "category": "unresponsive",
      "kind": "warning",
      "sources": [
        "rcuk-unresponsive"
      ],
      "patterns": [
        "\\b(?:unconscious|unresponsive|not responding|passed out|collapsed|not responsive|not conscious|lost consciousness)\\b",
        "\\b(?:cannot|could not|unable to|not able to) (?:wake|rouse) (?:him|her|them|my [a-z]+)\\b",
        "\\b(?:will not|does not|cannot) (?:wake(?: up)?|respond)\\b",
        "\\blimp.{0,25}(?:not responding|unresponsive)\\b"
      ]
    },
    {
      "id": "severe_bleeding_warning",
      "category": "severe_bleeding",
      "kind": "warning",
      "sources": [
        "sja-bleeding"
      ],
      "patterns": [
        "\\b(?:severe|major|heavy|uncontrolled|profuse|massive).{0,14}bleed(?:ing)?\\b",
        "\\bbleeding.{0,35}(?:will not stop|cannot stop|heavily|profusely|uncontrollably|very badly|a lot)\\b",
        "\\b(?:cannot|unable to) stop (?:the )?bleeding\\b",
        "\\bblood.{0,18}(?:spurting|gushing|pouring)\\b",
        "\\b(?:spurting|gushing|pouring).{0,16}blood\\b",
        "\\blosing (?:a lot of|lots of|much) blood\\b"
      ]
    },
    {
      "id": "reported_allergic_emergency",
      "category": "allergic_declaration",
      "kind": "declaration",
      "sources": [
        "nhs-allergy"
      ],
      "patterns": [
        "\\b(?:anaphylaxis|anaphylactic (?:reaction|shock)|severe allergic reaction)\\b"
      ]
    },
    {
      "id": "airway_swelling_warning",
      "category": "airway_swelling",
      "kind": "warning",
      "sources": [
        "nhs-allergy"
      ],
      "patterns": [
        "\\b(?:throat|tongue|lips|mouth).{0,32}(?:swell(?:ing|ed)?|swollen|closing|tight)\\b",
        "\\b(?:swollen|swelling).{0,22}(?:throat|tongue|lips|mouth)\\b"
      ]
    },
    {
      "id": "unresolved_warning_context",
      "category": "ambiguous_warning",
      "kind": "clarification",
      "sources": [
        "nhs-heart",
        "nhs-breathing",
        "nhs-stroke"
      ],
      "patterns": [
        "\\b(?:chest (?:pain|discomfort)|short of breath|slurred speech|slurring|trouble speaking|fainted|fainting|not being able to breathe|emergency)\\b"
      ]
    }
  ],
  "limitations": [
    "No clinician has approved this APIP matcher.",
    "English bounded literal/context rules are incomplete and may miss unfamiliar wording or context.",
    "No match is not medical clearance.",
    "No symptoms become Model A evidence or Model B labels through safety recognition.",
    "No treatment, medication, personalized precautions or hospital suitability is generated.",
    "Mention-local context and bounded antecedent handling are engineering heuristics, not validated clinical NLP. Relative-time language is not an approved numeric threshold."
  ]
