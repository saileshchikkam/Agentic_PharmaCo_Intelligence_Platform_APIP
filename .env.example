# Server-side Gemini API key for Agentic Pharmacovigilance multi-agent reasoning
GEMINI_API_KEY=
# Optional installed Ollama model for the local MedAssist quote-selection experiment.
# Fixed local endpoint; no cloud fallback. This is not a clinical assessment model.
MEDASSIST_MODEL=qwen3.5:2b

# Public browser configuration for Supabase Auth + account profiles.
# Never put a service-role key, secret key or Google client secret in VITE_*.
# Vite reads these at startup/build; restart after configuring.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development auth uses SQLite automatically when both VITE_* values above are empty.
# Optional SERVER environment override (startup does not load server values from .env):
# APIP_LOCAL_DB_PATH=path-to-a-private-accounts.sqlite

# Runtime variables must be supplied through the server environment.
# dev/start explicitly select NODE_ENV and reject conflicting inherited modes.
# APIP_HOST=127.0.0.1
# APIP_PORT=3000
# Development permits loopback/port 3000 only. Production may explicitly bind
# 0.0.0.0 and its deployment port. Legacy agents NEVER run in production.
# APIP_ENABLE_LEGACY_AGENTS=0
# Set exactly 1 only for deliberate local fictional development experiments.

# Model A research demo: supply these ONLY in the two local server processes.
# The server does not load this file automatically. Never use a VITE_* token.
# APIP_ENABLE_MODEL_A_DEMO=1
# MEDASSIST_A_ENABLE_RESEARCH=1
# MEDASSIST_A_TOKEN=<same-private-random-token-in-both-processes>
# MEDASSIST_A_RUN_ROOT=<preserved-original-sealed-run>
# MEDASSIST_A_METADATA_ROOT=<existing-verified-metadata-bundle>
# No files, weights or credentials belong in this example.

# Optional local MedGemma extraction, within the guarded fictional Model A demo only.
# APIP_ENABLE_MEDGEMMA=1
# MEDASSIST_LLM_MODEL=medgemma1.5:latest
# MEDASSIST_LLM_TIMEOUT_MS=60000
# MEDASSIST_LLM_DIGEST=<verified-installed-model-sha256>
# Already installed local GGUF only; no cloud fallback or automatic downloads.
# Initial-evidence proposals additionally require the hash-bound reliability-v1
# selection receipt to qualify this exact model/digest. Otherwise clarify only.
# A subset qualification is not clinical validation or completion of the L2 gate.

# Optional qualified Groq extraction: guarded fictional development only.
# APIP_ENABLE_GROQ_MODEL_A=1
# GROQ_API_KEY=<server-only-key-never-VITE>
# The qualified backend may read an explicitly authorized ignored .env.server.
# Free-plan confirmation and hash-bound groq-v1 evaluation are required.

# Optional modular composition inside BOTH existing research backend processes.
# APIP_ENABLE_MODULAR_MEDASSIST=1
# Does not enable disease/urgency/safety/hospital clinical execution.
