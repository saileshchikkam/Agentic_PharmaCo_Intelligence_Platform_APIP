# Server-side Gemini API key for Agentic Pharmacovigilance multi-agent reasoning
GEMINI_API_KEY=
# Optional installed Ollama model for the local MedAssist quote-selection experiment.
# Fixed local endpoint; no cloud fallback. This is not a clinical assessment model.
MEDASSIST_MODEL=qwen3.5:2b

# Public browser configuration for Supabase Auth + account profiles.
# Never put a service-role key, secret key or Google client secret in VITE_*.
# Vite reads these at startup/build; restart after configuring.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development auth uses SQLite automatically when both VITE_* values above are empty.
# Optional SERVER environment override (startup does not load server values from .env):
# APIP_LOCAL_DB_PATH=path-to-a-private-accounts.sqlite
