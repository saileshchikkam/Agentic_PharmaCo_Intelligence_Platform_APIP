.githooks/* text eol=lf
# Keep new research-code/report byte hashes stable on Windows checkouts.
models/medassist/research/*.py text eol=lf
models/medassist/research/tests/*.py text eol=lf
models/medassist/reports/**/*.json text eol=lf
models/medassist/requirements-phase1.txt text eol=lf
models/medassist/baseline-protocol.json text eol=lf
models/medassist/baseline-protocol.sha256 text eol=lf
models/medassist/reports/2026-10-19-phase3/*.md text eol=lf
models/medassist/research/audit/*.py text eol=lf
models/medassist/reports/2026-10-19-phase4a/*.md text eol=lf
models/medassist_v2/**/*.py text eol=lf
models/medassist_v2/**/*.json text eol=lf
models/medassist_v2/**/*.md text eol=lf
models/medassist_v2/requirements.txt text eol=lf
# Preserve the current bytes of new hash-bound research sources and receipts.
# This does not change the frozen Model A protocol or resolve its existing caveat.
models/medassist_ai/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
models/medassist_intelligence/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
models/medassist_v2/research_adapter/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Contributor provenance checks require canonical Git bytes, not checkout conversion.
app/data/processed/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
app/data/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
app/data/disease_specialization.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
app/ml/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
app/ml/*.joblib -text
requirements.txt -text
